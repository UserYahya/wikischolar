# Caddy behind the Cloudflare proxy (SSL/TLS mode "Full (strict)").
# TLS: Cloudflare Origin CA certificate in deploy/certs/ (no Let's Encrypt: the VM only accepts
# Cloudflare's IPs, so ACME challenges would be unreliable; the origin cert lasts 15 years).
{
	servers {
		# Only these addresses may tell us who the visitor is (www.cloudflare.com/ips, fetched 2026-10-06).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers Cf-Connecting-Ip
	}
}

{$SITE_ADDRESS} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	request_body {
		max_size 10MB
	}

	reverse_proxy web:8000 {
		# The app rate-limits by the FIRST X-Forwarded-For entry (apps/core/utils.py client_ip).
		# Replace the whole header with the one verified visitor IP so it can't be forged.
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format console
	}
}
