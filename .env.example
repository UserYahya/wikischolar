# ============================================================================
# FOR DOCKER / docker-compose ONLY. It points at the hosts "db" and "redis",
# which exist only inside docker-compose.
# cPanel or any server without Docker: use docs/cpanel.env.example instead.
# ============================================================================
# ---- Django --------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=register.wikischolar.bd
DJANGO_CSRF_TRUSTED_ORIGINS=https://register.wikischolar.bd
DJANGO_SSL_REDIRECT=1
LOG_LEVEL=INFO

# ---- PostgreSQL 16 (pg_trgm extension is created by migrations) ----------
DB_NAME=wikischolar
DB_USER=wikischolar
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# ---- Cache (strongly recommended with >1 gunicorn worker: rate limits) ----
REDIS_URL=redis://redis:6379/0

# ---- Email (OTP, confirmations, bulk) --------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WikiScholar <no-reply@wikischolar.bd>
# A Super Admin can instead set Brevo / Gmail / SMTP credentials on
# Dashboard -> Email settings; those override the EMAIL_* values above.
# Key that encrypts the stored password (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# If empty it is derived from DJANGO_SECRET_KEY. Changing it means re-entering the password.
WS_CREDENTIALS_KEY=

# ---- SMS (bulk only; console provider logs instead of sending) -------------
# A Super Admin can instead save MiM SMS credentials on Dashboard -> Email & SMS settings
# (stored encrypted); those override the values below.
NOTIFY_SMS_PROVIDER=apps.notifications.providers.sms.ConsoleSmsProvider
# NOTIFY_SMS_PROVIDER=apps.notifications.providers.sms.MimSmsProvider
SMS_API_URL=https://api.mimsms.com/api
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
# Shared secret the provider must send as ?token= on delivery-report webhooks
NOTIFY_WEBHOOK_TOKEN=change-me

# ---- WikiScholar ------------------------------------------------------------
WS_ID_PREFIX=WS
# Programme year shown in student IDs: WS-2027-000001. Leave empty to use the current calendar year.
WS_ID_YEAR=2027
WS_CONTACT_EMAIL=info@wikischolar.bd
WS_REPLY_TO=info@wikischolar.bd
# Cloudflare Turnstile (anti-bot check on "Send verification code" and the dashboard sign-in).
# Off while empty. Cloudflare dashboard -> Turnstile -> Add widget (add this app's domain), then copy both keys.
WS_TURNSTILE_SITE_KEY=
WS_TURNSTILE_SECRET_KEY=
WS_SITE_URL=https://wikischolar.bd
# This app's own public address (the logo in emails is loaded from here)
WS_PUBLIC_URL=https://register.wikischolar.bd
WS_POLICY_VERSION=2026-01
WS_POLICY_URL=https://wikischolar.bd/youth-policy
WS_OTP_TTL_MINUTES=10
WS_OTP_MAX_ATTEMPTS=5
WS_OTP_VERIFIED_WINDOW_MINUTES=60
# Local development only: returns the OTP in the API response when DJANGO_DEBUG=1
WS_OTP_DEBUG_ECHO=0
WS_SCHOOL_AUTO_RESOLVE=0.8
WS_SCHOOL_DUPLICATE=0.5
WS_INLINE_DISPATCH_MAX=300
WS_INLINE_DISPATCH_SECONDS=20
