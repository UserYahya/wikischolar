# WikiScholar on cPanel: copy to .env in the app folder (next to passenger_wsgi.py) and fill in.
# Keep this file private: it holds passwords. Real environment variables set in
# "Setup Python App" override anything here.
# There is deliberately NO REDIS_URL: shared hosting has no Redis (see DJANGO_CACHE below).

# ---- Django --------------------------------------------------------------
DJANGO_DEBUG=0
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=register.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://register.example.org
DJANGO_SSL_REDIRECT=1
# Set to 1 only if pages loop between http and https after enabling SSL
DJANGO_BEHIND_PROXY=0
LOG_LEVEL=INFO

# ---- PostgreSQL 13+ -------------------------------------------------------
# Option 1: the host's own database (cPanel -> PostgreSQL Databases). cPanel prefixes
# names with your account name, e.g. myacct_wikischolar. Needs PostgreSQL 13 or newer.
DB_NAME=myacct_wikischolar
DB_USER=myacct_wsuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Option 2: external PostgreSQL (e.g. Neon), when the host's is too old. Prefer the DIRECT
# host (no "-pooler" in it; a pooled host also works) and require SSL:
# DB_NAME=wikischolar
# DB_USER=wikischolar_owner
# DB_PASSWORD=
# DB_HOST=ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require

# ---- Cache: no Redis on shared hosting, so share rate limits via the database
DJANGO_CACHE=db

# ---- Email -----------------------------------------------------------------
# Set the real sending account on Dashboard -> Email & SMS settings (Brevo / Gmail / SMTP).
# Until then emails are only printed to the log (the dashboard shows a red warning).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=WikiScholar <no-reply@example.org>
# Optional fallback instead of the dashboard: uncomment and fill in all of these.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Encrypts the email password / SMS API key stored from the dashboard. Generate once and keep it:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WS_CREDENTIALS_KEY=

# ---- SMS fallback (normally set on the dashboard) --------------------------
NOTIFY_SMS_PROVIDER=apps.notifications.providers.sms.ConsoleSmsProvider
# Secret for delivery-report webhooks (Brevo: .../notifications/webhook/email/?token=THIS).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"   Empty = webhooks refused.
NOTIFY_WEBHOOK_TOKEN=

# ---- WikiScholar ------------------------------------------------------------
WS_ID_PREFIX=WS
WS_ID_YEAR=2027
WS_CONTACT_EMAIL=info@wikischolar.bd
# Reply-to of every outgoing email (Email settings can override it)
WS_REPLY_TO=info@wikischolar.bd
# Cloudflare Turnstile (anti-bot check on "Send verification code" and the dashboard sign-in).
# Off while empty. Cloudflare dashboard -> Turnstile -> Add widget (add this app's domain), then copy both keys.
WS_TURNSTILE_SITE_KEY=
WS_TURNSTILE_SECRET_KEY=
# The form's "Back to ..." link
WS_SITE_URL=https://wikischolar.bd
# This app's own public address (the logo in emails is loaded from here)
WS_PUBLIC_URL=https://registration.wikischolar.bd
# Bulk sends: up to this many recipients are sent from the browser, in chunks of N seconds
WS_INLINE_DISPATCH_MAX=300
WS_INLINE_DISPATCH_SECONDS=20
WS_POLICY_VERSION=2026-01
WS_POLICY_URL=https://wikischolar.bd/youth-policy
WS_OTP_DEBUG_ECHO=0
